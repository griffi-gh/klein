// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug native binary",
    "build": {
      "command": "ninja",
      "args": ["-Cbuild"],
      "cwd": "$ZED_WORKTREE_ROOT",
    },
    "program": "$ZED_WORKTREE_ROOT/build/klein",
    "request": "launch",
    "adapter": "CodeLLDB",
    "env": {
      "TERM": "ansi",
      "COLORTERM": "1",
    },
  },
]
